# ---------------------------------------------------------------------------
# Chat model: "azure" or "ollama"
# ---------------------------------------------------------------------------
# Switching this to ollama is the venue fallback: every demo runs locally.
LLM_PROVIDER=azure

# Azure OpenAI v1 endpoint. infra/setup.sh writes these for you.
# Format: https://<resource>.openai.azure.com/openai/v1/
#
# A Microsoft Foundry resource works too, with no code changes. Use the
# RESOURCE name in this same format, not the project endpoint
# (https://<resource>.services.ai.azure.com/api/projects/<project>).
# The deployment below must exist on that resource.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/

# The name YOU gave the deployment, which is not necessarily the model's name.
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini

# Leave blank to use Microsoft Entra ID (run `az login`). That is the
# recommended path; the key is here only for environments that need it.
AZURE_OPENAI_API_KEY=

# Reasoning effort for reasoning models: minimal, low, medium, or high.
# Leave blank to use the model's default.
REASONING_EFFORT=low

# Ollama's OpenAI-compatible endpoint and models.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen3:4b

# qwen3 thinks before answering by default. On a laptop that turns a one-second
# triage into minutes. "none" turns thinking off.
OLLAMA_REASONING_EFFORT=none

# ---------------------------------------------------------------------------
# Embeddings: "ollama" or "azure"
# ---------------------------------------------------------------------------
# Changing the embedding model means re-embedding everything:
#   uv run python demos/02_semantic_search/build_index.py --rebuild
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=embeddinggemma
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---------------------------------------------------------------------------
# Feature flags. The help desk works with every one of these off.
# ---------------------------------------------------------------------------
FEATURE_TRIAGE=true
FEATURE_SIMILAR_TICKETS=true
FEATURE_DRAFT_REPLY=true
FEATURE_ASSISTANT=true

# DuckDB database file, relative to code/.
HELPDESK_DB=data/helpdesk.duckdb

# ---------------------------------------------------------------------------
# Production settings
# ---------------------------------------------------------------------------
# The SDK defaults are a 10-minute timeout and 2 retries. Neither is right for
# a button a person is waiting on. Retries back off and cover 408, 409, 429,
# 5xx, and connection errors; the timeout applies to each attempt.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Prices in US dollars per million tokens, from your provider's price sheet.
# Leave blank and the cost report shows tokens without dollars.
CHAT_PRICE_INPUT_PER_MTOK=
CHAT_PRICE_OUTPUT_PER_MTOK=
EMBEDDING_PRICE_PER_MTOK=
